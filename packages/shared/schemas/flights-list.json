{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flightpath.local/schemas/flights-list.json",
  "title": "FlightsListResponse",
  "type": "object",
  "additionalProperties": false,
  "required": ["registration", "icao24", "from", "to", "flights"],
  "properties": {
    "registration": { "type": "string" },
    "icao24": { "type": "string" },
    "from": { "type": "string", "format": "date" },
    "to": { "type": "string", "format": "date" },
    "flights": {
      "type": "array",
      "items": { "$ref": "flight.json" }
    }
  }
}
